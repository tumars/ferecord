{
  "installCommand": "true",
  "buildCommand": "true",
  "outputDirectory": "./public",
  "redirects": [
    {
      "source": "$host",
      "destination": "$wwwhost",
      "statusCode": 301
    },
    {
      "source": "/art-history-atlas",
      "destination": "https://artclue.ferecord.com/",
      "statusCode": 301
    },
    {
      "source": "/art-history-atlas/",
      "destination": "https://artclue.ferecord.com/",
      "statusCode": 301
    },
    {
      "source": "/art-history-atlas/*",
      "destination": "https://artclue.ferecord.com/:splat",
      "statusCode": 301
    }
  ]
}
